<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<title>Be My Valentine?</title>
<style>
  body {
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    background: #ffe6f0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    margin: 0;
  }

  .card {
    background: white;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 10px 30px rgba(0,0,0,.15);
    text-align: center;
    max-width: 420px;
  }

  h1 {
    margin: 0 0 10px;
    color: #ff4d6d;
  }

  p {
    color: #444;
    margin-bottom: 20px;
  }

  button {
    font-size: 16px;
    border: none;
    border-radius: 999px;
    padding: 12px 18px;
    margin: 6px;
    cursor: pointer;
  }

  .yes {
    background: #ff4d6d;
    color: white;
  }

  .no {
    background: #eee;
    color: #555;
    position: relative;
  }
</style>
</head>
<body>

<div class="card">
  <h1>Be My Valentine? 💖</h1>
  <p>You + Me + Snacks + Vibes</p>
  <button class="yes" onclick="yes()">Yes 💘</button>
  <button class="no" onmouseover="moveNo()">No 🙃</button>
</div>

<script>
  function yes() {
    document.body.innerHTML =
      "<h1 style='color:#ff4d6d'>Yay! 💞</h1><p>Best decision ever.</p>";
  }

  function moveNo() {
    const btn = document.querySelector('.no');
    btn.style.left = Math.random() * 100 - 50 + "px";
    btn.style.top  = Math.random() * 100 - 50 + "px";
  }
</script>

</body>
</html>
